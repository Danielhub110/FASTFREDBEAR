else
listScroll.Visible = false
tpPlayerBtn.Position = UDim2.new(0, 15, 0, 195)
main.Size = UDim2.new(0, 280, 0, 455)
end
end
-- Teleport Systems
local function teleportToSafeZone()
local character = player.Character
if not character then return end
if isBuildABoat then
if character:FindFirstChild("HumanoidRootPart") then character:PivotTo(BAB_CFRAME) end
elseif isFastFredbear then
local rootPart = character:FindFirstChild("HumanoidRootPart")
if not rootPart then return end
local safeZonesFolder = Workspace:FindFirstChild("SafeZones")
local targetObj = safeZonesFolder and safeZonesFolder:FindFirstChild("NPCBOUNDS") or Workspace:FindFirstChild("NPCBOUNDS", true)
if targetObj and targetObj:IsA("BasePart") then
rootPart.CFrame = targetObj.CFrame + Vector3.new(0, 5, 0)
else
rootPart.CFrame = CFrame.new(FNAF_FREDBEAR_SAFEZONE) + Vector3.new(0, 5, 0)
end
end
end
local function teleportToSelectedPlayer()
if not selectedTargetPlayer or not selectedTargetPlayer.Character then
status.Text = "Error: Select a valid player target first!"
return
end
local targetRoot = selectedTargetPlayer.Character:FindFirstChild("HumanoidRootPart")
local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
if myRoot and targetRoot then
myRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
status.Text = "Teleported to " .. selectedTargetPlayer.DisplayName .. "!"
else
status.Text = "Target player has no spawned body!"
end
end
