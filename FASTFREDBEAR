-- ESP Engine
local function createHighlight(model, fill, outline)
if not model:IsA("Model") or model == player.Character then return end
local highlight = model:FindFirstChild("DeltaOutlineESP")
if not highlight then
highlight = Instance.new("Highlight")
highlight.Name = "DeltaOutlineESP"
highlight.FillColor = fill
highlight.FillTransparency = 0.55
highlight.OutlineColor = outline
highlight.OutlineTransparency = 0
highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
highlight.Parent = model
end
highlight.Enabled = espActive
end
local function cleanHighlights()
for _, p in ipairs(Players:GetPlayers()) do
if p.Character and p.Character:FindFirstChild("DeltaOutlineESP") then
p.Character.DeltaOutlineESP.Enabled = false
end
end
local enemiesFolder = Workspace:FindFirstChild("Enemies")
if enemiesFolder then
for _, enemy in ipairs(enemiesFolder:GetChildren()) do
if enemy:FindFirstChild("DeltaOutlineESP") then
enemy.DeltaOutlineESP.Enabled = false
end
end
end
end
local function scanWorld()
if not espActive then cleanHighlights() return end
for _, p in ipairs(Players:GetPlayers()) do
if p ~= player and p.Character then
createHighlight(p.Character, Color3.fromRGB(0, 150, 255), Color3.fromRGB(0, 230, 255))
end
end
local enemiesFolder = Workspace:FindFirstChild("Enemies")
if enemiesFolder then
for _, enemy in ipairs(enemiesFolder:GetChildren()) do
createHighlight(enemy, Color3.fromRGB(180, 0, 0), Color3.fromRGB(255, 30, 30))
end
end
end
task.spawn(function()
while task.wait(1.5) do
if not gui or not gui.Parent then break end
scanWorld()
end
end)
