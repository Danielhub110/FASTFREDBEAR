-- Runtime State Management Variables
local selectedSpeed = DEFAULT_SPEED
local espActive = true
local trackingFolder = Workspace:FindFirstChild("Enemies")

local function setSpeed(value)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = value
        status.Text = "Current speed: " .. value .. " | ESP: " .. (espActive and "ON" or "OFF")
    end
end

-- Core runtime enforcement loop (Prevents anti-cheat speed resets)
task.spawn(function()
    while task.wait(0.1) do
        if gui and gui.Parent then
            setSpeed(selectedSpeed)
        else
            break
        end
    end
end)

-- Core Outline Highlight Engine
local function createHighlight(model, fill, outline)
    if not model:IsA("Model") or model == player.Character then return end
    
    local highlight = model:FindFirstChild("DeltaOutlineESP")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "DeltaOutlineESP"
        highlight.FillColor = fill
        highlight.FillTransparency = 0.55 -- Semi-see-through inside body
        highlight.OutlineColor = outline
        highlight.OutlineTransparency = 0 -- Full bright clean solid line
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- See through walls!
        highlight.Parent = model
    end

    -- Keep highlight visibility in sync with master toggle button state
    highlight.Enabled = espActive
end

-- Clean out markers dynamically if toggled off
local function cleanHighlights()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("DeltaOutlineESP") then
            p.Character.DeltaOutlineESP.Enabled = false
        end
    end
    if trackingFolder then
        for _, enemy in ipairs(trackingFolder:GetChildren()) do
            if enemy:FindFirstChild("DeltaOutlineESP") then
				enemy.DeltaOutlineESP.Enabled = false
			end
        end
    end
end

local function scanWorld()
    if not espActive then 
        cleanHighlights()
        return 
    end

    -- 1. Track Real Players (Bright Neon Cyan Outlines)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            createHighlight(p.Character, Color3.fromRGB(0, 150, 255), Color3.fromRGB(0, 230, 255))
        end
    end
    
    -- 2. Track Custom Enemies folder from image context (Glow Neon Crimson Red Outlines)
    if trackingFolder then
        for _, enemy in ipairs(trackingFolder:GetChildren()) do
            createHighlight(enemy, Color3.fromRGB(180, 0, 0), Color3.fromRGB(255, 30, 30))
        end
    end
end

-- Active listening hooks manage world updates continuously
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(char)
        task.wait(1)
        if espActive then createHighlight(char, Color3.fromRGB(0, 150, 255), Color3.fromRGB(0, 230, 255)) end
    end)
end)

if trackingFolder then
    trackingFolder.ChildAdded:Connect(function(enemy)
        task.wait(0.5)
        if espActive then createHighlight(enemy, Color3.fromRGB(180, 0, 0), Color3.fromRGB(255, 30, 30)) end
    end)
end

task.spawn(function()
    while task.wait(1.5) do
        if not gui or not gui.Parent then break end
        scanWorld()
    end
end)

-- UI Interaction Event Hooks
apply.Activated:Connect(function()
    local value = tonumber(speedBox.Text)
    if not value or value ~= value or value == math.huge or value == -math.huge then
        status.Text = "Enter a valid number!"
        return
    end
    value = math.clamp(math.floor(value), 1, MAX_SPEED)
    selectedSpeed = value
    setSpeed(value)
end)

reset.Activated:Connect(function()
    selectedSpeed = DEFAULT_SPEED
    speedBox.Text = tostring(DEFAULT_SPEED)
    setSpeed(DEFAULT_SPEED)
end)

espToggle.Activated:Connect(function()
    espActive = not espActive
    if espActive then
        espToggle.BackgroundColor3 = Color3.fromRGB(20, 80, 40)
        espToggle.Text = "ESP OUTLINES: ON"
        scanWorld()
    else
        espToggle.BackgroundColor3 = Color3.fromRGB(120, 30, 30)
        espToggle.Text = "ESP OUTLINES: OFF"
        cleanHighlights()
    end
    setSpeed(selectedSpeed)
end)

closeButton.Activated:Connect(function()
    main.Visible = false
    openButton.Visible = true
end)

openButton.Activated:Connect(function()
    main.Visible = true
    openButton.Visible = false
end)

-- Run initial sweep immediately upon injection
scanWorld()
