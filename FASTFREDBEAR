-- Runtime State Management Variables
local selectedSpeed = DEFAULT_SPEED
local selectedJump = DEFAULT_JUMP
local espActive = true

local function updateCharacterStats()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = selectedSpeed
        humanoid.UseJumpPower = true
        humanoid.JumpPower = selectedJump
    end
end

-- Core runtime enforcement loop (Prevents anti-cheat resetting stats)
task.spawn(function()
    while task.wait(0.1) do
        if gui and gui.Parent then
            updateCharacterStats()
        else
            break
        end
    end
end)

-- Core Outline Highlight Engine
local function createHighlight(model, fill, outline)
    if not model:IsA("Model") or model == player.Character then return end
    local highlight = model:FindFirstChild("DeltaOutlineESP")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "DeltaOutlineESP"
        highlight.FillColor = fill
        highlight.FillTransparency = 0.55
        highlight.OutlineColor = outline
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = model
    end
    highlight.Enabled = espActive
end

local function cleanHighlights()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("DeltaOutlineESP") then
            p.Character.DeltaOutlineESP.Enabled = false
        end
    end
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, enemy in ipairs(enemiesFolder:GetChildren()) do
            if enemy:FindFirstChild("DeltaOutlineESP") then
                enemy.DeltaOutlineESP.Enabled = false
            end
        end
    end
end

local function scanWorld()
    if not espActive then 
        cleanHighlights()
        return 
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            createHighlight(p.Character, Color3.fromRGB(0, 150, 255), Color3.fromRGB(0, 230, 255))
        end
    end
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, enemy in ipairs(enemiesFolder:GetChildren()) do
            createHighlight(enemy, Color3.fromRGB(180, 0, 0), Color3.fromRGB(255, 30, 30))
        end
    end
end

task.spawn(function()
    while task.wait(1.5) do
        if not gui or not gui.Parent then break end
        scanWorld()
    end
end)

-- Multi-Layer Smart Teleport Execution
local function teleportToSafeZone()
    local character = player.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

local safeZonesFolder = Workspace:FindFirstChild("SafeZones")
local targetObj = safeZonesFolder and safeZonesFolder:FindFirstChild("NPCBOUNDS") or Workspace:FindFirstChild("NPCBOUNDS", true)
if targetObj and targetObj:IsA("BasePart") then
rootPart.CFrame = targetObj.CFrame + Vector3.new(0, 5, 0)
status.Text = "Speed: "..selectedSpeed.." | Jump: "..selectedJump.."\n🎯 Teleported to Map Object!"
else
rootPart.CFrame = CFrame.new(BACKUP_SAFEZONE_POSITION) + Vector3.new(0, 5, 0)
status.Text = "Speed: "..selectedSpeed.." | Jump: "..selectedJump.."\n🌐 Map Unloaded! Used Position Cords."
end
end
-- UI Interaction Event Hooks
applySpeed.Activated:Connect(function()
local speedVal = tonumber(speedBox.Text)
if speedVal and speedVal == speedVal and speedVal ~= math.huge and speedVal ~= -math.huge then
selectedSpeed = math.clamp(math.floor(speedVal), 1, MAX_SPEED)
speedBox.Text = tostring(selectedSpeed)
status.Text = "Speed: " .. selectedSpeed .. " | Jump: " .. selectedJump .. "\nWalkSpeed updated successfully!"
else
status.Text = "Enter a valid number for Speed!"
end
updateCharacterStats()
end)
applyJump.Activated:Connect(function()
local jumpVal = tonumber(jumpBox.Text)
if jumpVal and jumpVal == jumpVal and jumpVal ~= math.huge and jumpVal ~= -math.huge then
selectedJump = math.clamp(math.floor(jumpVal), 0, MAX_JUMP)
jumpBox.Text = tostring(selectedJump)
status.Text = "Speed: " .. selectedSpeed .. " | Jump: " .. selectedJump .. "\nJumpPower updated successfully!"
else
status.Text = "Enter a valid number for Jump!"
end
updateCharacterStats()
end)
resetAll.Activated:Connect(function()
selectedSpeed = DEFAULT_SPEED
selectedJump = DEFAULT_JUMP
speedBox.Text = tostring(DEFAULT_SPEED)
jumpBox.Text = tostring(DEFAULT_JUMP)
updateCharacterStats()
status.Text = "Speed: 16 | Jump: 50\nAll stats reset to defaults."
end)
espToggle.Activated:Connect(function()
espActive = not espActive
if espActive then
espToggle.BackgroundColor3 = Color3.fromRGB(20, 80, 40)
espToggle.Text = "ESP OUTLINES: ON"
scanWorld()
else
espToggle.BackgroundColor3 = Color3.fromRGB(120, 30, 30)
espToggle.Text = "ESP OUTLINES: OFF"
cleanHighlights()
end
end)
tpSafeZone.Activated:Connect(function()
teleportToSafeZone()
end)
